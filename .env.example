# Copy to .env (gitignored). Restart the services after editing.

# Claude (runs on a Claude subscription via the Claude Code CLI). Create a long-lived token with
# `claude setup-token` and paste it here:
# CLAUDE_CODE_OAUTH_TOKEN=
# STUDIO_LLM_MODEL=sonnet

# Postiz (publishing). API base and key from Postiz → Settings → Public API.
# POSTIZ_URL=http://localhost:4007/api/public/v1
# POSTIZ_API_KEY=
# Public HTTPS address of Postiz (needed for social logins and Instagram media):
# POSTIZ_PUBLIC_URL=https://postiz.example.com

# Server
# STUDIO_PORT=8794
# STUDIO_HOST=127.0.0.1

# Monitoring defaults
# STUDIO_CHECK_INTERVAL_MIN=180
